# /etc/xm/watch.env に置く設定。root 所有・0600 にすること
# （Webhook の URL は、それを知っている人なら誰でも通知を送れる鍵と同じ）
#
#   sudo install -m 600 -o root -g root deploy/watch.env.example /etc/xm/watch.env
#   sudo nano /etc/xm/watch.env
#
# 書き換えたら反映する:
#   sudo systemctl restart xm-watch

# 通知先の Webhook URL（Discord か Slack）。
# 未設定なら送信せず journal に出るだけになる。つまり誰にも届かない。
SIGNAL_WEBHOOK_URL=

# 戦略のパラメータ。未設定なら既定値を使う。
# 変える前に `npm run backtest` で影響を確かめること。
# XM_ATR_STOP_MULTIPLIER=1.5
# XM_RISK_REWARD_RATIO=2.0

NODE_ENV=production
# 相場データの取得先は外に出る。VPS がプロキシ越しなら指定する
# HTTPS_PROXY=
